---
/**
 * A small CRT television. Its screen shows live static and "tunes in" to the
 * slot content when it scrolls into view (see scripts/fx.ts).
 */
interface Props { channel?: string; class?: string; tone?: 'dark' | 'light' }
const { channel = '01', class: cls, tone = 'dark' } = Astro.props;
---
<div class:list={['crt', `crt--${tone}`, cls]} data-crt aria-hidden="true">
  <div class="crt__screen">
    <canvas class="crt__noise" width="120" height="80" data-crt-noise></canvas>
    <div class="crt__content" data-crt-content><slot /></div>
    <i class="crt__scan"></i>
    <i class="crt__roll" data-crt-roll></i>
  </div>
  <div class="crt__base">
    <span class="crt__ch">CH.{channel}</span>
    <span class="crt__knobs"><i></i><i></i></span>
  </div>
</div>
<style>
  .crt {
    --body: #2b2d35;
    display: grid; gap: 6px; padding: 9px 9px 7px;
    background: var(--body);
    border-radius: 14px;
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.06), 6px 7px 0 rgb(0 0 0 / 0.55);
    outline: 3px solid var(--asphalt);
  }
  .crt__screen {
    position: relative; aspect-ratio: 3 / 2; overflow: hidden;
    background: #07080a;
    border-radius: 18px / 24px;
    box-shadow: inset 0 0 22px rgb(0 0 0 / 0.9);
  }
  .crt__noise { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; opacity: 0.9; }
  .crt__content {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 2px;
    text-align: center; color: var(--volt);
    font-family: var(--f-display); line-height: 1;
    /* chromatic aberration rather than glow */
    text-shadow: -1.5px 0 rgb(255 40 120 / 0.75), 1.5px 0 rgb(40 220 255 / 0.75);
  }
  /* hidden until the tune-in effect runs; reduced-motion visitors see it straight away */
  :global(.motion) .crt__content { opacity: 0; }
  :global(html:not(.motion)) .crt__noise { opacity: 0.12; }
  .crt__scan { position: absolute; inset: 0; background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.35) 2px 3px); pointer-events: none; }
  .crt__roll {
    position: absolute; left: 0; right: 0; top: -30%; height: 22%;
    background: linear-gradient(transparent, rgb(255 255 255 / 0.07), transparent);
    pointer-events: none;
  }
  .crt__base { display: flex; justify-content: space-between; align-items: center; padding: 0 4px; }
  .crt__ch { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.16em; color: var(--smoke); }
  .crt__knobs { display: flex; gap: 5px; }
  .crt__knobs i { width: 7px; height: 7px; border-radius: 50%; background: #45474f; }
  .crt__knobs i:last-child { background: var(--hazard); }
</style>

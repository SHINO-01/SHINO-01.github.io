---
import SectionHead from './SectionHead.astro';
import Dots from './Dots.astro';
import Icon from './Icon.astro';
import Chevrons from './Chevrons.astro';
import SpeedLines from './SpeedLines.astro';
import { asset } from '../lib/data';
import type { CollectionEntry } from 'astro:content';
import type { SiteCopy } from '../lib/data';

interface Props { projects: CollectionEntry<'projects'>['data'][]; copy: SiteCopy['projects']; index: string; github?: string }
const { projects, copy, index, github } = Astro.props;
const stars = { S: 5, A: 4, B: 3 } as const;
---
<section class="projects" id="projects" aria-labelledby="projects-title" data-projects>
  <Dots tone="volt" />
  <div class="projects__bg halftone" aria-hidden="true"></div>
  <div class="projects__pin" data-proj-pin>
    <!-- giant outlined backdrop word, drifts slower than the cards -->
    <div class="projects__word display" aria-hidden="true" data-proj-word>{copy.title} {copy.jp} {copy.title}</div>

    <div class="projects__track" data-proj-track>
      <div class="projects__intro">
        <SectionHead id="projects-title" index={index} title={copy.title} kicker={copy.kicker} tone="light" jp={copy.jp} />
        <SpeedLines fx={0.32} fy={0.42} tone="ink" class="projects__speed" />
        <p class="projects__lede">{copy.lede}</p>
        <div class="projects__conveyor" data-proj-slab>
          <Chevrons dir="right" label={copy.scrollHint} />
        </div>
      </div>

      {projects.map((p, i) => (
        <article class:list={['pcard', `pcard--${p.color}`]} data-pcard>
          <div class="pcard__inner" data-tilt>
            <div class="pcard__art" aria-hidden="true">
              {p.image ? <img src={asset(p.image)} alt="" loading="lazy" /> : (
                <>
                  <div class="pcard__stripes"></div>
                  <span class="pcard__glyph display" data-depth="30">{p.glyph ?? p.name.slice(0, 2)}</span>
                  <span class="pcard__glyph pcard__glyph--echo display" data-depth="12">{p.glyph ?? p.name.slice(0, 2)}</span>
                </>
              )}
              <div class="pcard__scan"></div>
              <span class="pcard__no">No.{String(i + 1).padStart(3, '0')}</span>
              <div class="pcard__rank" data-depth="40">
                <span class="display">{p.rank}</span>
                <span class="pcard__stars">{'★'.repeat(stars[p.rank])}</span>
              </div>
              <div class="pcard__holo"></div>
            </div>
            <div class="pcard__body">
              <header>
                <h3 class="pcard__name display">{p.name}</h3>
                <p class="pcard__tagline">{p.tagline}{p.year && <span> · {p.year}</span>}</p>
              </header>
              <ul class="pcard__list">
                {p.highlights.map((h) => <li>{h}</li>)}
              </ul>
              <ul class="pcard__stack" aria-label="Built with">
                {p.stack.map((t) => <li title={t}><Icon name={t} /><span>{t}</span></li>)}
              </ul>
              {p.links.length > 0 && (
                <div class="pcard__links">
                  {p.links.map((l, j) => (
                    <a class:list={['pcard__link', j === 0 && 'is-primary']} href={l.url} target="_blank" rel="noopener">
                      {l.label}
                      <span class="sr-only"> for {p.name} (opens in a new tab)</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}

      {github && (
        <a class="projects__more" href={github} target="_blank" rel="noopener" data-magnetic>
          <Icon name="github" />
          <span class="display">{copy.moreTitle}</span>
          <span class="projects__more-sub">{copy.moreText}</span>
        </a>
      )}
    </div>

    <!-- ruler HUD: fills as you browse, each project marker lights up as its card reaches centre -->
    <div class="phud" aria-hidden="true" data-proj-hud>
      <div class="phud__rule"><i class="phud__fill" data-proj-progress></i></div>
      {projects.map((_, i) => <span class="phud__mark" data-proj-mark>No.{String(i + 1).padStart(3, '0')}</span>)}
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative; z-index: 2;
    background: var(--volt); color: var(--asphalt);
    overflow: clip;
  }
  .projects__bg { position: absolute; inset: 0; color: var(--asphalt); opacity: 0.1; -webkit-mask-image: linear-gradient(110deg, transparent 20%, #000 70%); mask-image: linear-gradient(110deg, transparent 20%, #000 70%); }
  .projects__pin { position: relative; min-height: 100svh; display: flex; align-items: center; }
  .projects__track { position: relative; z-index: 1; }

  .projects__word {
    position: absolute; left: 0; bottom: 4%; z-index: 0;
    font-size: clamp(8rem, 21vw, 22rem); line-height: 0.8; white-space: nowrap;
    color: transparent; -webkit-text-stroke: 2px rgb(16 16 19 / 0.13);
    pointer-events: none; will-change: transform;
  }

  .projects__intro { position: relative; }
  .projects__intro :global(.projects__speed) {
    top: -160px !important; left: calc(-1 * var(--gutter)) !important;
    width: calc(100% + var(--gutter) + 120px) !important; height: calc(100% + 320px) !important; z-index: -1;
  }
  .projects__conveyor {
    position: relative; margin-top: 34px; margin-left: calc(-1 * var(--gutter));
    width: calc(100% + var(--gutter) + 40px);
    clip-path: polygon(0 0, 100% 0, calc(100% - 26px) 100%, 0 100%);
    transform-origin: left;
  }
  .projects__conveyor :global(.chev) { height: 46px; }
  .projects__conveyor :global(.chev__label) { left: var(--gutter); font-size: 0.78rem; background: var(--volt); color: var(--asphalt); }

  .phud { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 30px; z-index: 2; height: 34px; pointer-events: none; }
  .phud__rule {
    position: absolute; left: 0; right: 0; bottom: 0; height: 12px;
    background: repeating-linear-gradient(90deg, rgb(16 16 19 / 0.35) 0 2px, transparent 2px 16px) bottom / 100% 6px no-repeat;
    border-bottom: 2px solid rgb(16 16 19 / 0.35);
  }
  .phud__fill { position: absolute; left: 0; right: 0; bottom: -2px; height: 6px; background: var(--asphalt); transform-origin: left; transform: scaleX(0); }
  .phud__mark {
    position: absolute; bottom: 18px; translate: -50% 0;
    font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.1em;
    padding: 2px 8px; color: var(--asphalt); background: rgb(16 16 19 / 0.08);
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    transition: background-color 0.3s, color 0.3s;
  }
  .phud__mark::after { content: ''; position: absolute; left: 50%; bottom: -18px; width: 2px; height: 16px; background: currentColor; }
  .phud__mark.is-on { background: var(--asphalt); color: var(--volt); }
  .projects__track {
    display: flex; align-items: center; gap: clamp(20px, 2.4vw, 36px);
    padding: 110px var(--gutter) 90px;
    width: max-content;
    will-change: transform;
  }
  .projects__intro { width: clamp(380px, 44vw, 640px); flex: none; align-self: center; }
  .projects__intro :global(.shead__title) { font-size: clamp(2.4rem, 4.6vw, 5rem); }
  .projects__intro :global(.shead__kicker) { color: rgb(16 16 19 / 0.7); }
  .projects__lede { font-size: var(--t-lg); line-height: 1.45; font-weight: 500; max-width: 32ch; }

  /* ── card ── */
  .pcard { --accent: var(--volt); --accent-ink: var(--asphalt); flex: none; width: clamp(330px, 31vw, 470px); perspective: 1200px; }
  .pcard--ether { --accent: var(--ether); --accent-ink: var(--paper); }
  .pcard--hazard { --accent: var(--hazard); --accent-ink: var(--asphalt); }
  .pcard--cyan { --accent: var(--cyan); --accent-ink: var(--asphalt); }
  .pcard__inner {
    --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 50%;
    position: relative;
    background: var(--asphalt); color: var(--paper);
    clip-path: var(--chamfer); --cut: 26px;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out);
  }
  .pcard__inner.is-tilting { transition: none; }

  .pcard__art {
    position: relative; height: clamp(150px, 22vh, 230px); overflow: hidden;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .pcard__art img { width: 100%; height: 100%; object-fit: cover; }
  .pcard__stripes {
    position: absolute; inset: 0; opacity: 0.18;
    background: repeating-linear-gradient(-45deg, currentColor 0 2px, transparent 2px 14px);
  }
  .pcard__glyph {
    position: absolute; left: 6%; bottom: -0.16em;
    font-size: clamp(6rem, 10vw, 9.5rem); line-height: 1;
    color: var(--asphalt);
    transition: transform 0.5s var(--ease-out);
  }
  .pcard--ether .pcard__glyph { color: var(--paper); }
  .pcard__glyph--echo { color: transparent !important; -webkit-text-stroke: 2px currentColor; translate: 14px -12px; opacity: 0.6; z-index: 0; }
  .pcard--ether .pcard__glyph--echo { -webkit-text-stroke-color: var(--paper); }
  .pcard__glyph--echo { -webkit-text-stroke-color: var(--asphalt); }
  .pcard__scan { position: absolute; inset: 0; background: repeating-linear-gradient(transparent 0 3px, rgb(0 0 0 / 0.08) 3px 4px); pointer-events: none; }
  .pcard__no { position: absolute; left: 16px; top: 14px; font-weight: 700; font-size: var(--t-xs); letter-spacing: 0.14em; }
  .pcard__rank {
    position: absolute; right: 16px; top: 12px; display: grid; justify-items: end;
    transition: transform 0.5s var(--ease-out);
  }
  .pcard__rank .display { font-size: 3.4rem; line-height: 0.9; color: var(--asphalt); -webkit-text-stroke: 0; text-shadow: 3px 3px 0 var(--paper); }
  .pcard--ether .pcard__rank .display { color: var(--paper); text-shadow: 3px 3px 0 var(--asphalt); }
  .pcard__stars { font-size: 0.8rem; letter-spacing: 2px; }
  .pcard__holo {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; mix-blend-mode: color-dodge;
    background:
      radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / 0.65), transparent 40%),
      linear-gradient(115deg, transparent 20%, #ff4fd8 35%, #4fffe0 50%, #fff95c 65%, transparent 80%);
    background-size: 100% 100%, 250% 250%;
    background-position: center, var(--mx) var(--my);
    transition: opacity 0.4s;
  }
  .pcard__inner:hover .pcard__holo { opacity: 0.55; }

  .pcard__body { padding: 22px 24px 24px; display: grid; gap: 14px; }
  .pcard__name { font-size: clamp(1.7rem, 2.4vw, 2.2rem); line-height: 1; }
  .pcard__tagline { margin-top: 6px; color: var(--accent); font-weight: 600; font-size: var(--t-sm); }
  .pcard--ether .pcard__tagline { color: #b9a1ff; }
  .pcard__list { display: grid; gap: 7px; font-size: 0.9rem; line-height: 1.45; color: #cfcfc8; }
  .pcard__list li { position: relative; padding-left: 16px; }
  .pcard__list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 2px; background: var(--accent); }
  .pcard__stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .pcard__stack li { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; background: var(--steel); font-size: var(--t-xs); font-weight: 600; }
  .pcard__stack :global(svg), .pcard__stack :global(.icon-mono) { width: 13px; height: 13px; }
  .pcard__links { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px; }
  .pcard__link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 12px; font-weight: 700; font-size: var(--t-sm);
    box-shadow: inset 0 0 0 2px var(--steel);
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .pcard__link svg { width: 15px; height: 15px; transition: transform 0.3s var(--ease-out); }
  .pcard__link:hover svg { transform: translate(2px, -2px); }
  .pcard__link.is-primary { background: var(--accent); color: var(--accent-ink); box-shadow: none; }
  .pcard__link:hover { background: var(--paper); color: var(--asphalt); box-shadow: none; }

  .projects__more {
    flex: none; width: clamp(240px, 20vw, 300px); aspect-ratio: 3 / 4;
    display: grid; align-content: end; gap: 10px; padding: 26px;
    background: transparent; color: var(--asphalt);
    box-shadow: inset 0 0 0 3px var(--asphalt);
    clip-path: var(--chamfer); --cut: 26px;
    transition: background-color 0.3s, color 0.3s;
  }
  .projects__more :global(svg) { width: 44px; height: 44px; margin-bottom: auto; }
  .projects__more .display { font-size: 1.8rem; line-height: 1; }
  .projects__more-sub { font-weight: 500; font-size: var(--t-sm); }
  .projects__more:hover { background: var(--asphalt); color: var(--volt); }


  @media (max-width: 900px) {
    .projects__pin { min-height: 0; }
    .projects__track { flex-direction: column; align-items: stretch; width: auto; padding-top: 100px; }
    .projects__intro, .pcard, .projects__more { width: 100%; }
    .projects__more { aspect-ratio: auto; min-height: 200px; }
    .phud, .projects__conveyor, .projects__intro :global(.projects__speed) { display: none; }
    .projects__word { font-size: 9rem; bottom: auto; top: 60px; }
  }
</style>

---
import SectionHead from './SectionHead.astro';
import Dots from './Dots.astro';
import Icon from './Icon.astro';
import Crt from './Crt.astro';
import Chevrons from './Chevrons.astro';
import Ticker from './Ticker.astro';
import SpeedLines from './SpeedLines.astro';
import { fmtMonth, duration } from '../lib/data';
import type { CollectionEntry } from 'astro:content';
import type { SiteCopy } from '../lib/data';

interface Props { experience: CollectionEntry<'experience'>['data'][]; copy: SiteCopy['missions']; index: string }
const { experience, copy, index } = Astro.props;

/** Short company mark for the CRT screen: "W3 Engineers Ltd" → "W3", "SForger" → "SF". */
const mark = (name: string) => {
  const words = name.split(/\s+/).filter((w) => !/^(ltd|inc|llc|pty|co)\.?$/i.test(w));
  if (words[0].length <= 3) return words[0].toUpperCase();
  if (words.length > 1) return words.slice(0, 3).map((w) => w[0]).join('').toUpperCase();
  const caps = words[0].replace(/[^A-Z]/g, '');
  return (caps.length >= 2 ? caps.slice(0, 3) : words[0].slice(0, 2)).toUpperCase();
};
const yy = (ym: string) => (ym === 'present' ? 'NOW' : `${ym.slice(2, 4)}.${ym.slice(5, 7)}`);
---
<section class="missions" id="missions" aria-labelledby="missions-title">
  <Dots tone="dark" />
  <div class="missions__inner">
    <SectionHead id="missions-title" index={index} title={copy.title} kicker={copy.kicker} jp={copy.jp} />

    <div class="log-wrap" data-log>
    <div class="log__spine" aria-hidden="true"><i data-log-fill></i></div>
    <ol class="log">
      {experience.map((job, i) => {
        const active = job.end === 'present';
        const num = String(experience.length - i).padStart(2, '0');
        return (
          <li class:list={['mission', i % 2 ? 'mission--r' : 'mission--l']} data-mission>
            <div class="mission__node" aria-hidden="true" data-mission-node>
              <svg viewBox="0 0 40 46"><path d="M20 2 38 12.5v21L20 44 2 33.5v-21Z" /></svg>
              <span>{num}</span>
            </div>
            <article class="mission__card" data-mission-card>
              <header class="mission__head">
                <p class="mission__company">
                  <span class="mission__company-name">{job.company}</span>
                  {job.location && <span class="mission__loc">{job.location}</span>}
                </p>
                <span class:list={['mission__status', active && 'is-active']}>{active ? 'Active' : 'Cleared'}</span>
              </header>
              <h3 class="mission__role display">{job.role}</h3>
              <p class="mission__time">
                <time datetime={job.start}>{fmtMonth(job.start)}</time>
                <span aria-hidden="true" class="mission__arrow"></span>
                {active ? <span>Present</span> : <time datetime={job.end}>{fmtMonth(job.end)}</time>}
                <span class="mission__dur">{duration(job.start, job.end)}</span>
              </p>
              <ul class="mission__list">
                {job.highlights.map((h) => <li>{h}</li>)}
              </ul>
              {job.stack.length > 0 && (
                <ul class="mission__stack" aria-label="Tools used">
                  {job.stack.map((t) => <li class="chip"><Icon name={t} />{t}</li>)}
                </ul>
              )}
              <span class="mission__stamp display" aria-hidden="true" data-stamp>{active ? 'In progress' : 'Cleared'}</span>
            </article>

            {/* motion-graphic panel that fills the empty side of the timeline */}
            <div class="mside" aria-hidden="true" data-mside>
              <SpeedLines fx={i % 2 ? 0.34 : 0.66} fy={0.2} class="mside__speed" />
              <span class="mside__year display" data-mside-year>{job.start.slice(0, 4)}</span>
              <div class="mside__hatch" data-mside-hatch>
                <Ticker class="mside__ticker" reverse={i % 2 === 1} items={[job.company, `${yy(job.start)} — ${yy(job.end)}`, active ? 'In progress' : 'Mission cleared', job.location ?? '', ...job.stack].filter(Boolean)} />
              </div>
              <div class="mside__tag" data-mside-tag>
                <span class="mside__label">Mission</span>
                <span class="mside__num display" data-odometer={num}>{num}</span>
              </div>
              <Crt channel={num} class="mside__crt">
                <span class="mside__crt-mark">{mark(job.company)}</span>
                <span class="mside__crt-dates">{yy(job.start)}–{yy(job.end)}</span>
              </Crt>
              <Chevrons dir={i % 2 ? 'right' : 'left'} class="mside__chev" />
              <span class="mside__jp">{active ? '任務進行中' : '任務完了'}</span>
            </div>
          </li>
        );
      })}
    </ol>
    </div>
  </div>
</section>

<style>
  .missions {
    position: relative; z-index: 1;
    padding: clamp(100px, 12vw, 160px) var(--gutter) clamp(120px, 12vw, 180px);
    background:
      linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 100% 48px,
      var(--asphalt);
  }
  .missions__inner {
    max-width: 1320px; margin: 0 auto;
    /* distance from the content edge to the viewport edge, so side panels can bleed off-screen */
    --bleed: max(var(--gutter), calc((100vw - 1320px) / 2));
  }

  .log-wrap { position: relative; }
  .log { position: relative; display: grid; gap: clamp(28px, 4vw, 48px); padding: 0; list-style: none; }
  .log__spine { position: absolute; left: 50%; top: 0; bottom: 0; width: 6px; margin-left: -3px; background: var(--steel); }
  .log__spine i { position: absolute; inset: 0; background: var(--volt); transform-origin: top; transform: scaleY(var(--p, 1)); box-shadow: 0 0 24px rgb(215 255 31 / 0.5); }

  .mission { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 90px; }
  .mission__card { position: relative; }
  .mission--l .mission__card { grid-column: 1; }
  .mission--r .mission__card { grid-column: 2; }
  .mission__node {
    position: absolute; left: 50%; top: 22px; z-index: 2;
    width: 52px; height: 60px; margin-left: -26px;
    display: grid; place-items: center;
  }
  .mission__node svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--asphalt); stroke: var(--volt); stroke-width: 3; }
  .mission__node span { position: relative; font-family: var(--f-display); color: var(--volt); font-size: 1rem; }

  .mission__card {
    padding: clamp(22px, 2.6vw, 34px);
    background: var(--panel);
    clip-path: var(--chamfer); --cut: 22px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
    overflow: hidden;
    transition: background-color 0.3s;
  }
  .mission__card::before {
    /* corner notch on the side that faces the spine, aligned with the node */
    content: ''; position: absolute; top: 0; width: 34px; height: 34px; background: var(--volt);
  }
  .mission--l .mission__card::before { right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .mission--r .mission__card::before { left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .mission__card:hover { background: #202128; }

  .mission__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
  .mission__company { display: grid; gap: 2px; }
  .mission__company-name { font-weight: 700; font-size: var(--t-lg); color: var(--volt); line-height: 1.15; }
  .mission__loc { font-size: var(--t-sm); color: var(--smoke); }
  .mission__status {
    flex: none; font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px; background: var(--steel); color: var(--paper);
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .mission__status.is-active { background: var(--volt); color: var(--asphalt); }
  .mission__role { font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.02; }
  .mission__time { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 12px 0 18px; font-weight: 600; font-size: var(--t-sm); }
  .mission__arrow { width: 22px; height: 2px; background: var(--paper); position: relative; }
  .mission__arrow::after { content: ''; position: absolute; right: -1px; top: -3px; width: 6px; height: 8px; background: var(--paper); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .mission__dur { color: var(--asphalt); background: var(--paper); padding: 1px 8px; font-size: var(--t-xs); font-weight: 700; }
  .mission__list { display: grid; gap: 10px; color: #cfcfc8; }
  .mission__list li { position: relative; padding-left: 22px; max-width: 62ch; }
  .mission__list li::before { content: ''; position: absolute; left: 2px; top: 0.6em; width: 8px; height: 8px; background: var(--volt); rotate: 45deg; }
  .mission__stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }

  .mission__card > :not(.mission__stamp) { position: relative; z-index: 1; }
  .mission__stamp {
    position: absolute; right: 22px; top: 50%; translate: 0 -50%; z-index: 0;
    opacity: 0.22;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem); line-height: 1;
    color: transparent; -webkit-text-stroke: 2px rgb(215 255 31 / 0.35);
    rotate: -10deg; pointer-events: none;
    padding: 4px 10px; border: 3px solid rgb(215 255 31 / 0.35);
  }

  /* ── side panels: ZZZ-style lime tag, hatched slab, film strip, giant year ── */
  .mside { position: relative; grid-row: 1; min-height: 420px; pointer-events: none; }
  :global(.mside__speed) { inset: -30px 0 -10px !important; width: calc(100% + var(--bleed)) !important; height: calc(100% + 40px) !important; z-index: 0; }
  .mission--l :global(.mside__speed) { left: auto !important; right: calc(-1 * var(--bleed)) !important; }
  .mission--r :global(.mside__speed) { left: calc(-1 * var(--bleed)) !important; }

  :global(.mside__ticker) { position: absolute; bottom: 10px; color: var(--smoke); }
  .mission--l :global(.mside__ticker) { left: 100px; right: var(--bleed); }
  .mission--r :global(.mside__ticker) { right: 100px; left: var(--bleed); }

  :global(.mside__crt) { position: absolute; top: 158px; width: 176px; z-index: 4; pointer-events: auto; }
  .mission--l :global(.mside__crt) { left: 74px; rotate: -4deg; }
  .mission--r :global(.mside__crt) { right: 74px; rotate: 4deg; }
  .mside__crt-mark { font-size: 2.3rem; }
  .mside__crt-dates { font-family: var(--f-ui); font-weight: 700; font-size: 0.62rem; letter-spacing: 0.14em; color: var(--paper); text-shadow: none; }

  :global(.mside__chev) { position: absolute; top: 312px; width: 64%; z-index: 3; }
  .mission--l :global(.mside__chev) { left: 0; clip-path: polygon(0 0, 100% 0, calc(100% - 22px) 100%, 0 100%); }
  .mission--r :global(.mside__chev) { right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%, 22px 100%); }

  .mside__tag.is-impact { background: var(--asphalt); color: var(--volt); }
  .mission--l .mside { grid-column: 2; }
  .mission--r .mside { grid-column: 1; }

  .mside__year {
    position: absolute; bottom: -10px; z-index: 0;
    font-size: clamp(6rem, 11vw, 10.5rem); line-height: 0.8;
    color: transparent; -webkit-text-stroke: 2px rgb(241 240 234 / 0.08);
  }
  .mission--l .mside__year { right: 0; }
  .mission--r .mside__year { left: 0; }

  .mside__hatch {
    position: absolute; top: 118px; height: 132px; z-index: 1;
    width: calc(88% + var(--bleed));
    background:
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 9px),
      #1f2026;
  }
  .mission--l .mside__hatch { right: calc(-1 * var(--bleed)); clip-path: polygon(70px 0, 100% 0, 100% 100%, 0 100%); transform-origin: right; }
  .mission--r .mside__hatch { left: calc(-1 * var(--bleed)); clip-path: polygon(0 0, 100% 0, calc(100% - 70px) 100%, 0 100%); transform-origin: left; }

  .mside__tag {
    position: absolute; top: 22px; z-index: 2;
    width: calc(64% + var(--bleed)); height: 150px;
    display: grid; align-content: center;
    background: var(--volt); color: var(--asphalt);
  }
  .mission--l .mside__tag { right: calc(-1 * var(--bleed)); padding-left: 84px; clip-path: polygon(64px 0, 100% 0, 100% 100%, 0 100%); }
  .mission--r .mside__tag { left: calc(-1 * var(--bleed)); padding-right: 84px; justify-items: end; text-align: right; clip-path: polygon(0 0, 100% 0, calc(100% - 64px) 100%, 0 100%); }
  .mside__label { font-weight: 700; font-size: var(--t-lg); line-height: 1; }
  .mside__num { font-size: clamp(4.5rem, 7vw, 6.5rem); line-height: 0.82; }



  .mside__jp {
    position: absolute; top: 22px; z-index: 3;
    writing-mode: vertical-rl;
    font-family: var(--f-display); font-size: 0.95rem; letter-spacing: 0.3em; color: var(--volt);
  }
  .mission--l .mside__jp { left: 40px; }
  .mission--r .mside__jp { right: 40px; }

  @media (max-width: 900px) {
    .mside { display: none; }
    .log__spine { left: 18px; }
    .mission { grid-template-columns: 1fr; gap: 0; padding-left: 52px; }
    .mission--l .mission__card, .mission--r .mission__card { grid-column: 1; }
    .mission__node { left: 18px; width: 40px; height: 46px; margin-left: -20px; }
    .mission__node span { font-size: 0.8rem; }
    .mission--l .mission__card::before { right: auto; left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
    .mission__stamp { display: none; }
  }
</style>

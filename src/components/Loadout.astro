---
import SectionHead from './SectionHead.astro';
import Dots from './Dots.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import type { SiteCopy } from '../lib/data';

interface Props { skills: CollectionEntry<'skills'>['data']; copy: SiteCopy['loadout']; index: string }
const { skills, copy, index } = Astro.props;

const N = skills.attributes.length;
const C = 210, R = 150;
const pt = (i: number, r: number) => {
  const a = (Math.PI * 2 * i) / N - Math.PI / 2;
  return [C + Math.cos(a) * r, C + Math.sin(a) * r];
};
const ring = (f: number) => skills.attributes.map((_, i) => pt(i, R * f).join(',')).join(' ');
const shape = skills.attributes.map((s, i) => pt(i, (R * s.value) / 100).join(',')).join(' ');

/** Break a label into at most two lines at the word boundary closest to its middle. */
const lines = (label: string) => {
  const words = label.split(' ');
  if (label.length <= 14 || words.length < 2) return [label];
  let best = 1, bestDiff = Infinity;
  for (let k = 1; k < words.length; k++) {
    const diff = Math.abs(words.slice(0, k).join(' ').length - words.slice(k).join(' ').length);
    if (diff < bestDiff) { bestDiff = diff; best = k; }
  }
  return [words.slice(0, best).join(' '), words.slice(best).join(' ')];
};
---
<section class="loadout" id="loadout" aria-labelledby="loadout-title">
  <Dots tone="light" />
  <div class="loadout__edge" aria-hidden="true"></div>
  <div class="loadout__inner">
    <SectionHead id="loadout-title" index={index} title={copy.title} kicker={copy.kicker} tone="light" jp={copy.jp} />

    <div class="loadout__grid">
      <figure class="radar" data-radar data-values={JSON.stringify(skills.attributes.map((s) => s.value))} data-center={C} data-radius={R}>
        <svg viewBox="-130 -12 690 448" role="img" aria-labelledby="radar-desc">
          <desc id="radar-desc">Areas of focus: {skills.attributes.map((s) => s.name).join(', ')}.</desc>
          <g class="radar__grid">
            {[1, 0.75, 0.5, 0.25].map((f) => <polygon points={ring(f)} />)}
            {skills.attributes.map((_, i) => { const [x, y] = pt(i, R); return <line x1={C} y1={C} x2={x} y2={y} />; })}
          </g>
          <polygon class="radar__shape" points={shape} data-radar-shape />
          {skills.attributes.map((s, i) => { const [x, y] = pt(i, (R * s.value) / 100); return <circle class="radar__node" cx={x} cy={y} r="5" data-radar-node />; })}
          {skills.attributes.map((s, i) => {
            const [x, y] = pt(i, R + 22);
            const anchor = Math.abs(x - C) < 8 ? 'middle' : x > C ? 'start' : 'end';
            const ls = lines(s.name);
            // top label sits above its vertex, bottom label below, side labels centred on it
            const y0 = y < C - 8 ? y - (ls.length - 1) * 21 - 6 : y > C + 8 ? y + 20 : y - (ls.length - 1) * 10.5 + 6;
            return (
              <text class="radar__name" x={x} y={y0} text-anchor={anchor} data-radar-label>
                {ls.map((l, j) => <tspan x={x} dy={j ? 21 : 0}>{l}</tspan>)}
              </text>
            );
          })}
        </svg>
      </figure>

      <div class="slots">
        {skills.loadout.map((slot) => (
          <div class="slot" data-slot>
            <h3 class="slot__name">{slot.slot}</h3>
            <ul class="slot__items">
              {slot.items.map((item) => (
                <li class="gear" data-gear>
                  <Icon name={item} class="gear__icon" />
                  <span class="gear__name">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .loadout {
    position: relative; z-index: 2;
    background: var(--concrete); color: var(--asphalt);
    padding: clamp(110px, 12vw, 170px) var(--gutter) clamp(90px, 10vw, 140px);
    margin-top: -1px;
  }
  .loadout__edge {
    position: absolute; left: 0; right: 0; top: -79px; height: 80px;
    background: var(--concrete);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .loadout__inner { max-width: 1320px; margin: 0 auto; }
  .loadout__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 80px); align-items: center; }

  .radar { position: relative; margin: 0; }
  .radar svg { width: 100%; height: auto; overflow: visible; }
  .radar__grid polygon { fill: none; stroke: rgb(16 16 19 / 0.22); stroke-width: 1.5; }
  .radar__grid polygon:first-child { fill: rgb(16 16 19 / 0.04); stroke: var(--asphalt); stroke-width: 2.5; }
  .radar__grid line { stroke: rgb(16 16 19 / 0.18); stroke-dasharray: 3 4; }
  .radar__shape { fill: rgb(215 255 31 / 0.85); stroke: var(--asphalt); stroke-width: 3; stroke-linejoin: round; mix-blend-mode: multiply; }
  .radar__node { fill: var(--ether); stroke: var(--asphalt); stroke-width: 2.5; }
  .radar__name { font-family: var(--f-ui); font-weight: 700; font-size: 19px; fill: var(--asphalt); }

  .slots { display: grid; gap: 26px; }
  .slot__name {
    font-family: var(--f-ui); font-weight: 700; font-size: var(--t-sm); letter-spacing: 0.12em; text-transform: uppercase;
    padding-bottom: 8px; margin-bottom: 12px; border-bottom: 2px solid var(--asphalt);
  }
  .slot__items { display: flex; flex-wrap: wrap; gap: 8px; }
  .gear {
    --brand: var(--volt);
    position: relative;
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 14px 9px 10px;
    background: var(--paper);
    font-weight: 600; font-size: var(--t-sm);
    clip-path: var(--chamfer); --cut: 9px;
    box-shadow: inset 0 0 0 2px var(--asphalt);
    transition: translate 0.3s var(--ease-out), background-color 0.25s, color 0.25s;
  }
  .gear:hover { background: var(--asphalt); color: var(--paper); translate: 0 -3px; }
  .gear :global(.gear__icon) { width: 20px; height: 20px; flex: none; transition: transform 0.4s var(--ease-out); }
  .gear:hover :global(.gear__icon) { transform: rotate(-12deg) scale(1.15); color: var(--volt); }

  @media (max-width: 900px) {
    .loadout__grid { grid-template-columns: 1fr; }
    .radar { max-width: 460px; margin-inline: auto; width: 100%; }
    .radar__name { font-size: 22px; }
  }
</style>

---
import { asset } from '../lib/data';
interface Props { codename: string; cv?: string; sections: { id: string; label: string }[] }
const { codename, cv, sections } = Astro.props;
---
<header class="nav" data-nav>
  <a class="nav__logo" href="#agent" aria-label={`${codename}, back to top`}>
    <svg class="nav__badge" viewBox="0 0 40 46" aria-hidden="true">
      <path d="M20 1 39 12v22L20 45 1 34V12Z" fill="var(--volt)" stroke="var(--asphalt)" stroke-width="2" />
      <text x="20" y="31" text-anchor="middle" font-family="Dela Gothic One" font-size="21" fill="var(--asphalt)">{codename[0]}</text>
    </svg>
    <span class="nav__word display">{codename}</span>
  </a>

  <nav class="nav__tabs" aria-label="Sections">
    <span class="nav__pill" data-nav-pill aria-hidden="true"></span>
    {sections.map((s) => (
      <a class="nav__link" href={`#${s.id}`} data-nav-link={s.id} data-scramble>{s.label}</a>
    ))}
  </nav>

  <div class="nav__actions">
    {cv && (
      <a class="btn nav__cv" href={asset(cv)} download data-magnetic>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" /></svg>
        <span>Download CV</span>
      </a>
    )}
    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span class="sr-only">Menu</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="mmenu" id="mobile-menu" data-mmenu hidden>
  <div class="mmenu__bg" aria-hidden="true"><i></i><i></i><i></i></div>
  <nav class="mmenu__links" aria-label="Sections">
    {sections.map((s, i) => (
      <a href={`#${s.id}`} data-mmenu-link><span class="mmenu__n">{String(i + 1).padStart(2, '0')}</span><span class="display">{s.label}</span></a>
    ))}
  </nav>
</div>

<!-- Right-edge section rail -->
<nav class="rail" aria-label="Section index" data-rail>
  {sections.map((s, i) => (
    <a href={`#${s.id}`} data-rail-link={s.id} aria-label={s.label}><span>{String(i + 1).padStart(2, '0')}</span></a>
  ))}
</nav>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 110;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 14px var(--gutter);
    pointer-events: none;
    transition: transform 0.5s var(--ease-snap);
  }
  .nav > * { pointer-events: auto; }
  .nav.is-hidden { transform: translateY(-110%); }
  .nav__logo { display: inline-flex; align-items: center; gap: 10px; justify-self: start; padding: 4px 16px 4px 5px; background: rgb(16 16 19 / 0.92); border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .nav__badge { width: 30px; height: 35px; transition: rotate 0.6s var(--ease-out); }
  .nav__logo:hover .nav__badge { rotate: 360deg; }
  .nav__word { font-size: 1.05rem; letter-spacing: 0.04em; }

  .nav__tabs {
    position: relative; display: flex; gap: 2px; padding: 5px;
    background: rgb(16 16 19 / 0.92);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .nav__pill {
    position: absolute; top: 5px; bottom: 5px; left: 0; width: 0;
    background: var(--paper); border-radius: 999px;
    transition: transform 0.5s var(--ease-out), width 0.5s var(--ease-out);
  }
  .nav__link {
    position: relative; z-index: 1;
    padding: 8px 16px; border-radius: 999px;
    font-size: var(--t-sm); font-weight: 600; color: var(--paper);
    transition: color 0.3s;
    white-space: nowrap;
  }
  .nav__link.is-active { color: var(--asphalt); }
  .nav__link:not(.is-active):hover { color: var(--volt); }

  .nav__cv { --bg: var(--asphalt); --fg: var(--volt); box-shadow: inset 0 0 0 2px var(--volt); }
  .nav__cv:hover { --fg: var(--asphalt); }
  .nav__cv::after { background: var(--volt); }
  .nav__actions { justify-self: end; display: flex; align-items: center; gap: 12px; }
  .nav__burger { display: none; width: 46px; height: 46px; background: var(--volt); position: relative; clip-path: var(--chamfer); --cut: 8px; }
  .nav__burger i { position: absolute; left: 12px; right: 12px; height: 3px; background: var(--asphalt); transition: transform 0.4s var(--ease-snap); }
  .nav__burger i:first-of-type { top: 17px; }
  .nav__burger i:last-of-type { top: 26px; }
  .nav__burger[aria-expanded='true'] i:first-of-type { transform: translateY(4.5px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] i:last-of-type { transform: translateY(-4.5px) rotate(-45deg); }

  .rail {
    position: fixed; right: 14px; top: 50%; z-index: 100;
    display: grid; gap: 6px; transform: translateY(-50%);
    transition: translate 0.5s var(--ease-snap);
  }
  .rail.is-away { translate: 80px 0; }
  .rail a {
    display: grid; place-items: center; width: 44px; height: 26px;
    font-size: 0.7rem; font-weight: 700; color: var(--smoke);
    background: rgb(16 16 19 / 0.7);
    clip-path: polygon(6px 0, 100% 0, 100% 100%, 0 100%, 0 6px);
    translate: 10px 0;
    transition: background-color 0.3s, color 0.3s, translate 0.3s var(--ease-out);
  }
  .rail a:hover { color: var(--paper); }
  .rail a.is-active { background: var(--volt); color: var(--asphalt); translate: 0 0; }

  .mmenu { position: fixed; inset: 0; z-index: 105; display: grid; align-content: center; padding: 90px var(--gutter) 40px; }
  .mmenu[hidden] { display: none; }
  .mmenu__bg { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .mmenu__bg i { background: var(--asphalt); }
  .mmenu__bg i:nth-child(2) { background: var(--panel); }
  .mmenu__links { position: relative; display: grid; gap: 8px; }
  .mmenu__links a { display: flex; align-items: baseline; gap: 14px; padding: 6px 0; border-bottom: 1px solid var(--steel); }
  .mmenu__links .display { font-size: clamp(2rem, 9vw, 3.4rem); }
  .mmenu__n { font-weight: 700; color: var(--volt); font-size: var(--t-sm); }

  @media (max-width: 1080px) {
    .nav__tabs { display: none; }
    .nav { grid-template-columns: 1fr auto; }
    .nav__burger { display: block; }
  }
  @media (max-width: 760px) {
    .rail { display: none; }
    .nav__cv span { display: none; }
    .nav__cv { padding: 0.85em; }
  }
</style>

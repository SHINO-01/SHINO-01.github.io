---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Tape from '../components/Tape.astro';
import Loadout from '../components/Loadout.astro';
import Missions from '../components/Missions.astro';
import Projects from '../components/Projects.astro';
import Records from '../components/Records.astro';
import Contact from '../components/Contact.astro';
import { loadSite } from '../lib/data';

const { site, profile, skills, experience, projects, education, publications } = await loadSite();

// Navigation order. Each id matches a section below.
const sections = (['agent', 'loadout', 'missions', 'projects', 'records', 'contact'] as const).map((id) => ({ id, label: site.nav[id] }));
const n = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const github = profile.socials.find((s) => s.icon.toLowerCase() === 'github')?.url;
---
<Layout title={`${profile.name} · ${profile.title}`} description={profile.tagline} codename={profile.codename} boot={site.boot}>
  <Nav slot="chrome" codename={profile.codename} cv={profile.cv} sections={sections} />
  <Hero profile={profile} copy={site.hero} />
  <!-- Hero tapes live outside the hero so they can run over the next section's edge. -->
  <div class="hero-tapes" aria-hidden="true" data-hero-tapes>
    <Tape items={[profile.availability.open ? profile.availability.label : profile.title, profile.location, profile.codename]} angle={-4} class="hero-tapes__a" />
    <Tape items={profile.roles} tone="dark" angle={3} reverse class="hero-tapes__b" />
  </div>
  <Loadout skills={skills} copy={site.loadout} index={n('loadout')} />
  <Missions experience={experience} copy={site.missions} index={n('missions')} />
  <div class="divider" aria-hidden="true">
    <Tape items={site.projects.banner} tone="hazard" angle={-2.5} />
  </div>
  <Projects projects={projects} copy={site.projects} index={n('projects')} github={github} />
  <Records education={education} publications={publications} copy={site.records} index={n('records')} />
  <Contact profile={profile} copy={site.contact} footer={site.footer} index={n('contact')} />
</Layout>

<style>
  .hero-tapes { position: relative; z-index: 4; height: 0; }
  .hero-tapes :global(.tape) { position: absolute; left: 0; }
  .hero-tapes :global(.hero-tapes__a) { bottom: 54px; }
  .hero-tapes :global(.hero-tapes__b) { bottom: 30px; }
  .divider { position: relative; z-index: 3; height: 0; }
  .divider :global(.tape) { position: absolute; top: -28px; }
</style>
